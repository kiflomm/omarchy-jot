pkgname=jot
pkgver=0.1.0
pkgrel=1
pkgdesc='Local notes and to-dos for the Omarchy desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/jot "$pkgdir/usr/bin/jot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/jot.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/jot.svg"
  install -Dm644 "$startdir/jot.desktop" "$pkgdir/usr/share/applications/jot.desktop"
}
